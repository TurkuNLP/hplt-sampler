#!/bin/bash

# IMPORTANT: #SBATCH directives are parsed by Slurm before this script runs,
# so they cannot read hplt-sampler.conf or any shell variable.
# Set --account and --partition for THIS job by either:
#   (a) editing the two #SBATCH lines below directly, OR
#   (b) overriding on the sbatch command line:
#         sbatch --account=project_X --partition=small sl-orchestrator eng_Latn [--wds 9-10]
# Worker jobs (counts, plan, sample, concat) read WORKER_PARTITION from hplt-sampler.conf.

#SBATCH --job-name=orchestrator
#SBATCH --account=YOUR_ACCOUNT_HERE
#SBATCH --partition=YOUR_PARTITION_HERE
#SBATCH --mem=8G
#SBATCH --time=72:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --output=slurm-logs/orch_%j.out
#SBATCH --error=slurm-logs/orch_%j.err

set -euo pipefail

# --- argument parsing ---
HPLT_LANG="eng_Latn"
WDS_SPEC=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --wds) WDS_SPEC="$2"; shift 2 ;;
    *)     HPLT_LANG="$1"; shift ;;
  esac
done

ROOT="${PWD}"

# --- run directory (all outputs scoped here; matched by results-*/ in .gitignore) ---
_wds_tag="${WDS_SPEC:-all}"
_wds_tag="${_wds_tag//,/+}"
RUNDIR="${ROOT}/results-${HPLT_LANG}-${_wds_tag}"
mkdir -p "${RUNDIR}"
echo "[ORCH] Run directory: ${RUNDIR}"

# --- detect system (used for preset defaults and BATCH sizing) ---
_detected_system="unknown"
if [[ -n "${LUMI_LMOD_FAMILY_COMPILER:-}" ]]; then
  _detected_system="lumi"
fi

# --- config ---
CONFIG="${ROOT}/hplt-sampler.conf"
# shellcheck source=/dev/null
[[ -f "${CONFIG}" ]] && source "${CONFIG}"
if [[ -z "${ACCOUNT:-}" ]]; then
  if [[ -t 0 ]]; then
    # Interactive terminal: prompt for required values.
    _preset="${ROOT}/presets/${_detected_system}.conf"
    # shellcheck source=/dev/null
    [[ -f "${_preset}" ]] && source "${_preset}"

    echo "[ORCH] No configuration found (hplt-sampler.conf missing or ACCOUNT not set)."
    if [[ "${_detected_system}" != "unknown" ]]; then
      echo "[ORCH] Detected system: ${_detected_system} — preset defaults loaded from presets/${_detected_system}.conf"
    else
      echo "[ORCH] System not recognised — check presets/ for system-specific templates."
    fi
    echo "[ORCH] Please provide the required values (Enter to accept defaults)."
    echo ""
    while [[ -z "${ACCOUNT:-}" ]]; do
      read -rp "  Slurm account (required, e.g. project_462000999): " ACCOUNT
      [[ -z "${ACCOUNT}" ]] && echo "  ACCOUNT is required."
    done
    read -rp "  Worker partition [${WORKER_PARTITION:-small}]: " _wp
    WORKER_PARTITION="${_wp:-${WORKER_PARTITION:-small}}"
    read -rp "  Module load command (leave empty if pip packages are available): " _mlc
    MODULE_LOAD_CMD="${_mlc:-}"
    echo ""
    read -rp "  Save to ${CONFIG}? [Y/n]: " _save
    if [[ "${_save,,}" != "n" ]]; then
      {
        echo "# Auto-generated by sl-orchestrator. Edit as needed."
        echo "ACCOUNT=\"${ACCOUNT}\""
        echo "WORKER_PARTITION=\"${WORKER_PARTITION}\""
        echo "MODULE_LOAD_CMD=\"${MODULE_LOAD_CMD}\""
      } > "${CONFIG}"
      echo "[ORCH] Configuration saved to ${CONFIG}."
    fi
    echo ""
  else
    echo "[ORCH] ERROR: ACCOUNT is not set. Copy hplt-sampler.conf.example to hplt-sampler.conf and set ACCOUNT." >&2
    exit 1
  fi
fi
WORKER_PARTITION="${WORKER_PARTITION:-small}"

# --- BATCH sizing (max array tasks per submission; can be overridden via BATCH= in hplt-sampler.conf) ---
# LUMI limits from partition table (running cap − 20 headroom):
#   small/small-g/standard-g: 200 running → 180
#   standard:                 100 running → 80
# Puhti/Mahti: 400 jobs/user global limit; no per-partition breakdown available.
#   Verify with: scontrol show partition <name>  (run on the target system)
if [[ -z "${BATCH:-}" ]]; then
  case "${_detected_system}:${WORKER_PARTITION}" in
    lumi:small|lumi:small-g|lumi:standard-g) BATCH=180 ;;
    lumi:standard)                            BATCH=80  ;;
    puhti:small|puhti:large|puhti:longrun)    BATCH=150 ;;
    mahti:small)                              BATCH=150 ;;
    *)                                        BATCH=100 ;;
  esac
  echo "[ORCH] BATCH=${BATCH} (auto: ${_detected_system}:${WORKER_PARTITION})"
fi

MAP_URL="https://data.hplt-project.org/three/sorted/${HPLT_LANG}.map"
SHARD_LIST="${RUNDIR}/shard_list.txt"
COUNTS_DIR="${ROOT}/counts/${HPLT_LANG}"
PLAN_FILE="${RUNDIR}/plan.jsonl"
SAMPLES_DIR="${RUNDIR}/samples"
FINAL_FILE="${RUNDIR}/samples.jsonl"

# worker script to launch (must be executable)
WORKER="${ROOT}/sl-hplt-sampler"

# --- WDS filter helper ---
build_wds_awk_pattern() {
  local spec="$1" parts=()
  if [[ "$spec" == *-* ]]; then
    local lo="${spec%-*}" hi="${spec#*-}"
    for ((i=lo; i<=hi; i++)); do parts+=("$i"); done
  else
    IFS=',' read -ra parts <<< "$spec"
  fi
  echo "($(IFS='|'; echo "${parts[*]}"))"
}

# build shard list (optionally filtered by WDS score)
if [[ -n "${WDS_SPEC}" ]]; then
  pat=$(build_wds_awk_pattern "${WDS_SPEC}")
  echo "[ORCH] Filtering shards to WDS scores matching: ${WDS_SPEC} (pattern: ${pat})"
  curl -s "$MAP_URL" | awk -F/ -v p="${pat}" '$NF ~ "^" p' > "$SHARD_LIST"
else
  echo "[ORCH] No WDS filter; using all shards"
  curl -s "$MAP_URL" > "$SHARD_LIST"
fi

NUMFILES=$(wc -l < "$SHARD_LIST" | tr -d ' ')
if [ -z "$NUMFILES" ] || [ "$NUMFILES" -eq 0 ]; then
  echo "No shards found for ${HPLT_LANG}" >&2
  exit 1
fi

JOB_COUNTS="hplt_counts"
JOB_PLAN="hplt_plan"
JOB_SAMPLE="hplt_sample"

sanitize_jobid() {
  local raw="$1"
  local s
  s=$(printf "%s" "${raw}" | tr -d '[:space:]')
  s=${s%%_*}
  if [[ -z "${s}" || ! "${s}" =~ ^[0-9]+$ ]]; then
    echo ""
  else
    echo "${s}"
  fi
}

# sbatch wrapper that retries on transient socket/timeout errors
sbatch_with_retry() {
  local attempt=0 max_attempts=5 delay=15 out rc
  while (( attempt < max_attempts )); do
    (( attempt++ ))
    out=$(sbatch "$@" 2>&1)
    rc=$?
    if (( rc == 0 )); then
      echo "$out"
      return 0
    fi
    if echo "$out" | grep -qi "socket timed out\|connection timed out"; then
      echo "[ORCH] sbatch transient error (attempt ${attempt}/${max_attempts}): ${out}" >&2
      if (( attempt < max_attempts )); then
        echo "[ORCH] Retrying in ${delay}s..." >&2
        sleep "${delay}"
        delay=$(( delay * 2 ))
      fi
    else
      echo "$out" >&2
      return "${rc}"
    fi
  done
  echo "[ORCH] sbatch failed after ${max_attempts} attempts" >&2
  return 1
}

last_counts_jobid=""
echo "[ORCH] Submitting counts in batches (BATCH=${BATCH}) for ${NUMFILES} shards"
for (( s=0; s<NUMFILES; s+=BATCH )); do
  e=$((s + BATCH - 1))
  if [ $e -ge $((NUMFILES - 1)) ]; then e=$((NUMFILES - 1)); fi

  # wait until no other count jobs of same name exist
  while true; do
    current=$(squeue -h -u "$USER" -n "$JOB_COUNTS" | wc -l | tr -d ' ')
    current=${current:-0}
    if [ "$current" -eq 0 ]; then break; fi
    echo "[ORCH] Waiting for existing ${JOB_COUNTS} jobs (${current}) to finish; sleeping 30s"
    sleep 30
  done

  echo "[ORCH] Submitting counts array ${s}-${e} (tasks 0-$((e - s)))"
  raw_id=$(sbatch_with_retry --parsable --job-name="${JOB_COUNTS}" --account="${ACCOUNT}" --partition="${WORKER_PARTITION}" --array="0-$((e - s))" --export=ALL,HPLT_LANG="${HPLT_LANG}",SHARD_LIST="${SHARD_LIST}",OFFSET=${s},MODE=counts "${WORKER}")
  jid=$(sanitize_jobid "${raw_id}")
  if [ -z "${jid}" ]; then
    echo "[ORCH] Failed to obtain valid counts job id from sbatch output: '${raw_id}'" >&2
    exit 1
  fi
  last_counts_jobid="${jid}"
  echo "[ORCH] Submitted counts job ${last_counts_jobid}"
done

# submit plan job dependent on last counts batch finishing
echo "[ORCH] Submitting plan job dependent on ${last_counts_jobid}"
raw_plan_id=$(sbatch_with_retry --parsable --job-name="${JOB_PLAN}" --account="${ACCOUNT}" --partition="${WORKER_PARTITION}" --dependency="afterok:${last_counts_jobid}" --export=ALL,HPLT_LANG="${HPLT_LANG}",SHARD_LIST="${SHARD_LIST}",COUNTS_DIR="${COUNTS_DIR}",PLAN_FILE="${PLAN_FILE}",MODE=plan "${WORKER}")
plan_jobid=$(sanitize_jobid "${raw_plan_id}")
if [ -z "${plan_jobid}" ]; then
  echo "[ORCH] Failed to obtain valid plan job id from sbatch output: '${raw_plan_id}'" >&2
  exit 1
fi
echo "[ORCH] Submitted plan job ${plan_jobid}"

# wait for plan job to finish (squeue will show it while pending/running)
echo "[ORCH] Waiting for plan job ${plan_jobid} to finish"
while true; do
  sleep 10
  if [ -z "$(squeue -h -j "${plan_jobid}" -o %.18i 2>/dev/null)" ]; then
    break
  fi
  echo "[ORCH] Plan job ${plan_jobid} still in queue; sleeping 20s"
  sleep 20
done
echo "[ORCH] Plan job ${plan_jobid} finished"

# return codes:
# 0 -> job exists in controller (can be used as dependency)
# 1 -> job not in controller but finished successfully (no dependency needed)
# 2 -> job not found / failed / unknown (treat as error)
check_job_for_dependency() {
  local jid="$1"
  if scontrol show job "${jid}" >/dev/null 2>&1; then
    return 0
  fi
  # job not in controller table; check accounting
  local sac
  sac=$(sacct -j "${jid}" -n -P -o State,ExitCode 2>/dev/null | head -n1 || true)
  if [ -z "${sac}" ]; then
    return 2
  fi
  local state="${sac%%|*}"
  local exitcode="${sac#*|}"
  if [ "${state}" = "COMPLETED" ] && [[ "${exitcode}" =~ ^0:0$ ]]; then
    return 1
  fi
  return 2
}

# submit sampling batches; each batch will run in parallel but batches are serialized by waiting for existing sample jobs
last_sample_jobid=""
echo "[ORCH] Submitting sampling in batches (BATCH=${BATCH})"
for (( s=0; s<NUMFILES; s+=BATCH )); do
  e=$((s + BATCH - 1))
  if [ $e -ge $((NUMFILES - 1)) ]; then e=$((NUMFILES - 1)); fi

  # wait until no other sample jobs of same name exist
  while true; do
    current=$(squeue -h -u "$USER" -n "$JOB_SAMPLE" | wc -l | tr -d ' ')
    current=${current:-0}
    if [ "$current" -eq 0 ]; then break; fi
    echo "[ORCH] Waiting for existing ${JOB_SAMPLE} jobs (${current}) to finish; sleeping 30s"
    sleep 30
  done

  echo "[ORCH] Submitting sample array ${s}-${e} (tasks 0-$((e - s)), depends on plan ${plan_jobid})"
  _dep_status=0; check_job_for_dependency "${plan_jobid}" || _dep_status=$?
  case $_dep_status in
    0)
      # plan job exists in controller -> safe to pass as dependency
      raw_sample_id=$(sbatch_with_retry --parsable --job-name="${JOB_SAMPLE}" --account="${ACCOUNT}" --partition="${WORKER_PARTITION}" --dependency="afterok:${plan_jobid}" --array="0-$((e - s))" --export=ALL,HPLT_LANG="${HPLT_LANG}",SHARD_LIST="${SHARD_LIST}",PLAN_FILE="${PLAN_FILE}",OFFSET=${s},MODE=sample "${WORKER}")
      ;;
    1)
      # plan finished successfully and was purged from controller -> submit without dependency
      echo "[ORCH] Plan ${plan_jobid} already finished (accounting OK); submitting sample array without dependency"
      raw_sample_id=$(sbatch_with_retry --parsable --job-name="${JOB_SAMPLE}" --account="${ACCOUNT}" --partition="${WORKER_PARTITION}" --array="0-$((e - s))" --export=ALL,HPLT_LANG="${HPLT_LANG}",SHARD_LIST="${SHARD_LIST}",PLAN_FILE="${PLAN_FILE}",OFFSET=${s},MODE=sample "${WORKER}")
      ;;
    *)
      echo "[ORCH] Plan job ${plan_jobid} not found or failed; aborting" >&2
      sacct -j "${plan_jobid}" --format=JobID,State,ExitCode,Submit,Start,End || true
      exit 1
      ;;
  esac

  sample_jid=$(sanitize_jobid "${raw_sample_id}")
  if [ -z "${sample_jid}" ]; then
    echo "[ORCH] Failed to obtain valid sample job id from sbatch output: '${raw_sample_id}'" >&2
    echo "[ORCH DEBUG] raw sbatch output: ${raw_sample_id}" >&2
    exit 1
  fi
  last_sample_jobid="${sample_jid}"
  echo "[ORCH] Submitted sample job ${last_sample_jobid}"
done

# submit concatenation job dependent on last sample batch
echo "[ORCH] Submitting concat job dependent on ${last_sample_jobid}"
_dep_status=0; check_job_for_dependency "${last_sample_jobid}" || _dep_status=$?
case $_dep_status in
  0)
    raw_concat_id=$(sbatch_with_retry --parsable --job-name="hplt_concat" --account="${ACCOUNT}" --partition="${WORKER_PARTITION}" --dependency="afterok:${last_sample_jobid}" --export=ALL,HPLT_LANG="${HPLT_LANG}",SAMPLES_DIR="${SAMPLES_DIR}",PLAN_FILE="${PLAN_FILE}",FINAL_FILE="${FINAL_FILE}",MODE=concat "${WORKER}")
    ;;
  1)
    echo "[ORCH] Sample batch ${last_sample_jobid} already finished (accounting OK); submitting concat without dependency"
    raw_concat_id=$(sbatch_with_retry --parsable --job-name="hplt_concat" --account="${ACCOUNT}" --partition="${WORKER_PARTITION}" --export=ALL,HPLT_LANG="${HPLT_LANG}",SAMPLES_DIR="${SAMPLES_DIR}",PLAN_FILE="${PLAN_FILE}",FINAL_FILE="${FINAL_FILE}",MODE=concat "${WORKER}")
    ;;
  *)
    echo "[ORCH] Sample job ${last_sample_jobid} not found or failed; aborting" >&2
    sacct -j "${last_sample_jobid}" --format=JobID,State,ExitCode,Submit,Start,End || true
    exit 1
    ;;
esac

concat_jid=$(sanitize_jobid "${raw_concat_id}")
if [[ -z "${concat_jid}" ]]; then
  echo "[ORCH] Failed to obtain valid concat job id from sbatch output: '${raw_concat_id}'" >&2
  exit 1
fi
echo "[ORCH] Submitted concat job ${concat_jid}"
echo "[ORCH] Orchestrator finished submitting pipeline. Monitor with squeue."
