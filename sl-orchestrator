#!/bin/bash

# IMPORTANT: #SBATCH directives are parsed by Slurm before this script runs,
# so they cannot read hplt-sampler.conf or any shell variable.
# Set --account and --partition for THIS job by either:
#   (a) editing the two #SBATCH lines below directly, OR
#   (b) overriding on the sbatch command line:
#         sbatch --account=project_X --partition=small sl-orchestrator eng_Latn [--wds 9-10] \
#           [--corpus v3|v4] [--local-root DIR] [--n-samples N] [--seed S] [--no-shuffle]
# Preview scope without submitting anything (no sbatch needed, writes nothing):
#         bash sl-orchestrator eng_Latn --corpus v4 --wds 9-10 --dry-run
# Worker jobs (counts, plan, sample, concat) read WORKER_PARTITION from hplt-sampler.conf.

#SBATCH --job-name=orchestrator
#SBATCH --account=YOUR_ACCOUNT_HERE
#SBATCH --partition=YOUR_PARTITION_HERE
#SBATCH --mem=8G
#SBATCH --time=72:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --output=slurm-logs/orch_%j.out
#SBATCH --error=slurm-logs/orch_%j.err

set -euo pipefail

# --- argument parsing ---
HPLT_LANG="eng_Latn"
WDS_SPEC=""
CORPUS="v3"
LOCAL_ROOT=""
N_SAMPLES=""
SEED_BASE=""
SHUFFLE=true
DRY_RUN=false
usage() {
  cat <<USAGE
Usage: sbatch [--account=X --partition=Y] sl-orchestrator [LANG] [options]
       bash sl-orchestrator [LANG] [options] --dry-run

  LANG                 HPLT language code, e.g. eng_Latn (default: eng_Latn)
  --wds SPEC           WDS scores to include: 9-10 | 8,9,10 | 10 (default: all shards)
  --corpus v3|v4       v3 streams over HTTP; v4 reads local files (default: v3)
  --local-root DIR     local corpus root containing LANG/ (v4 default: OpenEuroLLM copy on LUMI)
  --n-samples N        global sample size (default: plan.py default, 1000000)
  --seed S             run seed; per-shard seeds derive from it (default: drawn and recorded)
  --no-shuffle         keep the final sample grouped by shard (default: shuffled with a seed from S)
  --dry-run            list shards and estimate scope, then exit without submitting or writing
  -h, --help           show this help
USAGE
}
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)    usage; exit 0 ;;
    --dry-run)    DRY_RUN=true; shift ;;
    --no-shuffle) SHUFFLE=false; shift ;;
    --wds)        WDS_SPEC="$2"; shift 2 ;;
    --corpus)     CORPUS="$2"; shift 2 ;;
    --local-root) LOCAL_ROOT="$2"; shift 2 ;;
    --n-samples)  N_SAMPLES="$2"; shift 2 ;;
    --seed)       SEED_BASE="$2"; shift 2 ;;
    -*)           echo "[ORCH] ERROR: unknown option: $1" >&2; usage >&2; exit 1 ;;
    *)            HPLT_LANG="$1"; shift ;;
  esac
done
case "${CORPUS}" in
  v3|v4) ;;
  *) echo "[ORCH] ERROR: --corpus must be v3 or v4 (got '${CORPUS}')" >&2; exit 1 ;;
esac

ROOT="${PWD}"

# --- run directory (all outputs scoped here; matched by results-*/ in .gitignore) ---
_wds_tag="${WDS_SPEC:-all}"
_wds_tag="${_wds_tag//,/+}"
# v3 keeps its original names; other corpora are prefixed so runs and count caches never mix
_corpus_tag=""
[[ "${CORPUS}" != "v3" ]] && _corpus_tag="${CORPUS}-"
RUNDIR="${ROOT}/results-${_corpus_tag}${HPLT_LANG}-${_wds_tag}"
if ! ${DRY_RUN}; then
  mkdir -p "${RUNDIR}"
  echo "[ORCH] Run directory: ${RUNDIR}"
fi

# --- detect system (used for preset defaults and BATCH sizing) ---
# SLURM_CLUSTER_NAME is set by Slurm inside every job; fall back to module-system
# signals for login-node interactive use (currently only LUMI has a reliable marker).
_detected_system="${SLURM_CLUSTER_NAME:-unknown}"
if [[ "${_detected_system}" == "unknown" && -n "${LUMI_LMOD_FAMILY_COMPILER:-}" ]]; then
  _detected_system="lumi"
fi

# --- config ---
CONFIG="${ROOT}/hplt-sampler.conf"
# shellcheck source=/dev/null
[[ -f "${CONFIG}" ]] && source "${CONFIG}"
if [[ -z "${ACCOUNT:-}" ]] && ! ${DRY_RUN}; then
  if [[ -t 0 ]]; then
    # Interactive terminal: prompt for required values.
    _preset="${ROOT}/presets/${_detected_system}.conf"
    # shellcheck source=/dev/null
    [[ -f "${_preset}" ]] && source "${_preset}"

    echo "[ORCH] No configuration found (hplt-sampler.conf missing or ACCOUNT not set)."
    if [[ "${_detected_system}" != "unknown" ]]; then
      echo "[ORCH] Detected system: ${_detected_system} — preset defaults loaded from presets/${_detected_system}.conf"
    else
      echo "[ORCH] System not recognised — check presets/ for system-specific templates."
    fi
    echo "[ORCH] Please provide the required values (Enter to accept defaults)."
    echo ""
    while [[ -z "${ACCOUNT:-}" ]]; do
      read -rp "  Slurm account (required, e.g. project_462000999): " ACCOUNT
      [[ -z "${ACCOUNT}" ]] && echo "  ACCOUNT is required."
    done
    read -rp "  Worker partition [${WORKER_PARTITION:-small}]: " _wp
    WORKER_PARTITION="${_wp:-${WORKER_PARTITION:-small}}"
    read -rp "  Module load command (leave empty if pip packages are available): " _mlc
    MODULE_LOAD_CMD="${_mlc:-}"
    echo ""
    read -rp "  Save to ${CONFIG}? [Y/n]: " _save
    if [[ "${_save,,}" != "n" ]]; then
      {
        echo "# Auto-generated by sl-orchestrator. Edit as needed."
        echo "ACCOUNT=\"${ACCOUNT}\""
        echo "WORKER_PARTITION=\"${WORKER_PARTITION}\""
        echo "MODULE_LOAD_CMD=\"${MODULE_LOAD_CMD}\""
      } > "${CONFIG}"
      echo "[ORCH] Configuration saved to ${CONFIG}."
    fi
    echo ""
  else
    echo "[ORCH] ERROR: ACCOUNT is not set. Copy hplt-sampler.conf.example to hplt-sampler.conf and set ACCOUNT." >&2
    exit 1
  fi
fi
WORKER_PARTITION="${WORKER_PARTITION:-small}"
# WORKER_MEM (optional, conf) overrides the worker's #SBATCH --mem=32G; a per-shard reservoir
# needs far less, and on LUMI small requested memory is billed as cores.
WORKER_MEM="${WORKER_MEM:-}"

# --- BATCH sizing (max array tasks per submission; can be overridden via BATCH= in hplt-sampler.conf) ---
# LUMI limits from partition table (running cap − 20 headroom):
#   small/small-g/standard-g: 200 running → 180
#   standard:                 100 running → 80
# Puhti/Mahti: 400 jobs/user global limit; no per-partition breakdown available.
#   Verify with: scontrol show partition <name>  (run on the target system)
if [[ -z "${BATCH:-}" ]]; then
  case "${_detected_system}:${WORKER_PARTITION}" in
    lumi:small|lumi:small-g|lumi:standard-g) BATCH=180 ;;
    lumi:standard)                            BATCH=80  ;;
    puhti:small|puhti:large|puhti:longrun)    BATCH=150 ;;
    mahti:small)                              BATCH=150 ;;
    *)                                        BATCH=100 ;;
  esac
  echo "[ORCH] BATCH=${BATCH} (auto: ${_detected_system}:${WORKER_PARTITION})"
fi

# Shard source: v3 streams over HTTP from the HPLT map; v4 reads local files.
# HPLT v4 has no usable public map (2026-10-13: four/clean/*.map list /three/ URLs),
# so v4 needs a local copy. Default: the OpenEuroLLM catalogue copy on LUMI ("clean" = WDS 5-10).
if [[ "${CORPUS}" == "v4" && -z "${LOCAL_ROOT}" ]]; then
  LOCAL_ROOT="/appl/local/openeurollm/training/catalogue/hplt/4.0/clean"
fi
MAP_URL="https://data.hplt-project.org/three/sorted/${HPLT_LANG}.map"
SHARD_LIST="${RUNDIR}/shard_list.txt"
if ${DRY_RUN}; then
  SHARD_LIST=$(mktemp)
  trap 'rm -f "${SHARD_LIST}"' EXIT
fi
if [[ "${CORPUS}" == "v3" ]]; then
  COUNTS_DIR="${ROOT}/counts/${HPLT_LANG}"
else
  COUNTS_DIR="${ROOT}/counts/${CORPUS}/${HPLT_LANG}"
fi
PLAN_FILE="${RUNDIR}/plan.jsonl"
SAMPLES_DIR="${RUNDIR}/samples"
FINAL_FILE="${RUNDIR}/samples.jsonl"

# worker script to launch (must be executable)
WORKER="${ROOT}/sl-hplt-sampler"

# --- WDS filter helper ---
build_wds_awk_pattern() {
  local spec="$1" parts=()
  if [[ "$spec" == *-* ]]; then
    local lo="${spec%-*}" hi="${spec#*-}"
    for ((i=lo; i<=hi; i++)); do parts+=("$i"); done
  else
    IFS=',' read -ra parts <<< "$spec"
  fi
  echo "($(IFS='|'; echo "${parts[*]}"))"
}

# list all shards: URLs from the map (v3), or local paths (any corpus with --local-root).
# Hidden index files (.<shard>.urls.zst etc.) are excluded by the glob.
list_shards() {
  if [[ -n "${LOCAL_ROOT}" ]]; then
    if [[ ! -d "${LOCAL_ROOT}/${HPLT_LANG}" ]]; then
      echo "[ORCH] ERROR: no such directory: ${LOCAL_ROOT}/${HPLT_LANG}" >&2
      return 1
    fi
    ( shopt -s nullglob; printf '%s\n' "${LOCAL_ROOT}/${HPLT_LANG}"/*.jsonl.zst ) | sort -V
  else
    curl -s "$MAP_URL"
  fi
}
if [[ -n "${LOCAL_ROOT}" ]]; then
  echo "[ORCH] Corpus ${CORPUS}: local shards under ${LOCAL_ROOT}/${HPLT_LANG}"
else
  echo "[ORCH] Corpus ${CORPUS}: shards from ${MAP_URL}"
fi

# build shard list (optionally filtered by WDS score; the score is the filename prefix before "_")
if [[ -n "${WDS_SPEC}" ]]; then
  pat=$(build_wds_awk_pattern "${WDS_SPEC}")
  echo "[ORCH] Filtering shards to WDS scores matching: ${WDS_SPEC} (pattern: ${pat})"
  list_shards | awk -F/ -v p="${pat}" '$NF ~ "^" p "_"' > "$SHARD_LIST"
else
  echo "[ORCH] No WDS filter; using all shards"
  list_shards > "$SHARD_LIST"
fi

NUMFILES=$(wc -l < "$SHARD_LIST" | tr -d ' ')
if [ -z "$NUMFILES" ] || [ "$NUMFILES" -eq 0 ]; then
  echo "No shards found for ${HPLT_LANG}" >&2
  exit 1
fi

# --- dry run: report scope and exit before anything is written or submitted ---
if ${DRY_RUN}; then
  echo "[DRY-RUN] ${NUMFILES} shards for ${HPLT_LANG} (corpus ${CORPUS}, WDS ${WDS_SPEC:-all})"
  echo "[DRY-RUN] Shards per WDS score:"
  awk -F/ '{split($NF, a, "_"); n[a[1]]++} END {for (k in n) printf "  WDS %-3s %5d\n", k, n[k]}' "${SHARD_LIST}" | sort -k2n
  _cached=0
  while IFS= read -r _u; do
    [[ -f "${COUNTS_DIR}/${_u##*/}.json" ]] && _cached=$((_cached + 1))
  done < "${SHARD_LIST}"
  echo "[DRY-RUN] Counts already cached in ${COUNTS_DIR}: ${_cached}/${NUMFILES}"
  if [[ "${_cached}" -eq "${NUMFILES}" ]]; then
    _docs=$(cd "${COUNTS_DIR}" && sed 's|.*/||' "${SHARD_LIST}" | sed 's|$|.json|' | xargs cat | grep -o '"count": [0-9]*' | awk '{s+=$2} END {print s}')
    echo "[DRY-RUN] Documents in scope: ${_docs}"
  fi
  if [[ -n "${LOCAL_ROOT}" ]]; then
    _bytes=$(xargs -d '\n' stat -c '%s' < "${SHARD_LIST}" | awk '{s+=$1} END {print s}')
    awk -v b="${_bytes}" 'BEGIN {printf "[DRY-RUN] Compressed size: %.1f GB; one full read at ~85 MB/s per task (LUMI, measured 2026-10) is ~%.1f task-hours\n", b/1e9, b/85e6/3600}'
  fi
  echo "[DRY-RUN] Planned sample: ${N_SAMPLES:-1000000 (plan.py default)}; run directory would be ${RUNDIR}"
  echo "[DRY-RUN] Sampling reads every selected shard in full; uncached counts add one more pass where no index exists."
  echo "[DRY-RUN] Nothing submitted."
  exit 0
fi

# --- reproducibility: a run seed (drawn and recorded if not given) and a run record ---
if [[ -z "${SEED_BASE}" ]]; then
  SEED_BASE=$(( (RANDOM << 15) | RANDOM ))
  echo "[ORCH] No --seed given; drew seed ${SEED_BASE}"
fi
_git_rev=$(git -C "${ROOT}" rev-parse HEAD 2>/dev/null || echo unknown)
_git_dirty=$(git -C "${ROOT}" status --porcelain --untracked-files=no 2>/dev/null | grep -q . && echo true || echo false)
cat > "${RUNDIR}/run.json" <<RUNJSON
{
  "started": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "lang": "${HPLT_LANG}",
  "corpus": "${CORPUS}",
  "local_root": "${LOCAL_ROOT}",
  "map_url": "$([[ -z "${LOCAL_ROOT}" ]] && echo "${MAP_URL}")",
  "wds": "${WDS_SPEC:-all}",
  "n_samples": "${N_SAMPLES:-default}",
  "seed": ${SEED_BASE},
  "shuffle": ${SHUFFLE},
  "n_shards": ${NUMFILES},
  "sampler_commit": "${_git_rev}",
  "sampler_dirty": ${_git_dirty},
  "python": "$("${PYTHON:-python3}" -V 2>&1)",
  "cluster": "${_detected_system}",
  "slurm_job": "${SLURM_JOB_ID:-none}"
}
RUNJSON
# shard inventory (size, mtime): the corpus copy is not ours and may change between runs
if [[ -n "${LOCAL_ROOT}" ]]; then
  xargs -d '\n' stat --printf '%n\t%s\t%y\n' < "${SHARD_LIST}" > "${RUNDIR}/shard_inventory.tsv"
fi
echo "[ORCH] Run record: ${RUNDIR}/run.json"

# job names carry the run tag, so batches of one run never wait on another run's jobs
_run_tag="${_corpus_tag}${HPLT_LANG}-${_wds_tag}"
JOB_COUNTS="hplt_counts-${_run_tag}"
JOB_PLAN="hplt_plan-${_run_tag}"
JOB_SAMPLE="hplt_sample-${_run_tag}"
JOB_CONCAT="hplt_concat-${_run_tag}"

sanitize_jobid() {
  local raw="$1"
  local s
  s=$(printf "%s" "${raw}" | tr -d '[:space:]')
  s=${s%%_*}
  if [[ -z "${s}" || ! "${s}" =~ ^[0-9]+$ ]]; then
    echo ""
  else
    echo "${s}"
  fi
}

# sbatch wrapper that retries on transient socket/timeout errors
sbatch_with_retry() {
  local attempt=0 max_attempts=5 delay=15 out rc
  while (( attempt < max_attempts )); do
    (( attempt++ ))
    out=$(sbatch "$@" 2>&1)
    rc=$?
    if (( rc == 0 )); then
      echo "$out"
      return 0
    fi
    if echo "$out" | grep -qi "socket timed out\|connection timed out"; then
      echo "[ORCH] sbatch transient error (attempt ${attempt}/${max_attempts}): ${out}" >&2
      if (( attempt < max_attempts )); then
        echo "[ORCH] Retrying in ${delay}s..." >&2
        sleep "${delay}"
        delay=$(( delay * 2 ))
      fi
    else
      echo "$out" >&2
      return "${rc}"
    fi
  done
  echo "[ORCH] sbatch failed after ${max_attempts} attempts" >&2
  return 1
}

last_counts_jobid=""
echo "[ORCH] Submitting counts in batches (BATCH=${BATCH}) for ${NUMFILES} shards"
for (( s=0; s<NUMFILES; s+=BATCH )); do
  e=$((s + BATCH - 1))
  if [ $e -ge $((NUMFILES - 1)) ]; then e=$((NUMFILES - 1)); fi

  # wait until no other count jobs of same name exist
  while true; do
    current=$(squeue -h -u "$USER" -n "$JOB_COUNTS" | wc -l | tr -d ' ')
    current=${current:-0}
    if [ "$current" -eq 0 ]; then break; fi
    echo "[ORCH] Waiting for existing ${JOB_COUNTS} jobs (${current}) to finish; sleeping 30s"
    sleep 30
  done

  echo "[ORCH] Submitting counts array ${s}-${e} (tasks 0-$((e - s)))"
  raw_id=$(sbatch_with_retry --parsable --job-name="${JOB_COUNTS}" --account="${ACCOUNT}" --partition="${WORKER_PARTITION}" ${WORKER_MEM:+--mem="${WORKER_MEM}"} --array="0-$((e - s))" --export=ALL,HPLT_LANG="${HPLT_LANG}",SHARD_LIST="${SHARD_LIST}",COUNTS_DIR="${COUNTS_DIR}",OFFSET=${s},MODE=counts "${WORKER}")
  jid=$(sanitize_jobid "${raw_id}")
  if [ -z "${jid}" ]; then
    echo "[ORCH] Failed to obtain valid counts job id from sbatch output: '${raw_id}'" >&2
    exit 1
  fi
  last_counts_jobid="${jid}"
  echo "[ORCH] Submitted counts job ${last_counts_jobid}"
done

# submit plan job dependent on last counts batch finishing
echo "[ORCH] Submitting plan job dependent on ${last_counts_jobid}"
raw_plan_id=$(sbatch_with_retry --parsable --job-name="${JOB_PLAN}" --account="${ACCOUNT}" --partition="${WORKER_PARTITION}" ${WORKER_MEM:+--mem="${WORKER_MEM}"} --dependency="afterok:${last_counts_jobid}" --export=ALL,HPLT_LANG="${HPLT_LANG}",SHARD_LIST="${SHARD_LIST}",COUNTS_DIR="${COUNTS_DIR}",PLAN_FILE="${PLAN_FILE}",N_SAMPLES="${N_SAMPLES}",MODE=plan "${WORKER}")
plan_jobid=$(sanitize_jobid "${raw_plan_id}")
if [ -z "${plan_jobid}" ]; then
  echo "[ORCH] Failed to obtain valid plan job id from sbatch output: '${raw_plan_id}'" >&2
  exit 1
fi
echo "[ORCH] Submitted plan job ${plan_jobid}"

# wait for plan job to finish (squeue will show it while pending/running)
echo "[ORCH] Waiting for plan job ${plan_jobid} to finish"
while true; do
  sleep 10
  if [ -z "$(squeue -h -j "${plan_jobid}" -o %.18i 2>/dev/null)" ]; then
    break
  fi
  echo "[ORCH] Plan job ${plan_jobid} still in queue; sleeping 20s"
  sleep 20
done
echo "[ORCH] Plan job ${plan_jobid} finished"

# return codes:
# 0 -> job exists in controller (can be used as dependency)
# 1 -> job not in controller but finished successfully (no dependency needed)
# 2 -> job not found / failed / unknown (treat as error)
check_job_for_dependency() {
  local jid="$1"
  if scontrol show job "${jid}" >/dev/null 2>&1; then
    return 0
  fi
  # job not in controller table; check accounting
  local sac
  sac=$(sacct -j "${jid}" -n -P -o State,ExitCode 2>/dev/null | head -n1 || true)
  if [ -z "${sac}" ]; then
    return 2
  fi
  local state="${sac%%|*}"
  local exitcode="${sac#*|}"
  if [ "${state}" = "COMPLETED" ] && [[ "${exitcode}" =~ ^0:0$ ]]; then
    return 1
  fi
  return 2
}

# submit sampling batches; each batch will run in parallel but batches are serialized by waiting for existing sample jobs
last_sample_jobid=""
echo "[ORCH] Submitting sampling in batches (BATCH=${BATCH})"
for (( s=0; s<NUMFILES; s+=BATCH )); do
  e=$((s + BATCH - 1))
  if [ $e -ge $((NUMFILES - 1)) ]; then e=$((NUMFILES - 1)); fi

  # wait until no other sample jobs of same name exist
  while true; do
    current=$(squeue -h -u "$USER" -n "$JOB_SAMPLE" | wc -l | tr -d ' ')
    current=${current:-0}
    if [ "$current" -eq 0 ]; then break; fi
    echo "[ORCH] Waiting for existing ${JOB_SAMPLE} jobs (${current}) to finish; sleeping 30s"
    sleep 30
  done

  echo "[ORCH] Submitting sample array ${s}-${e} (tasks 0-$((e - s)), depends on plan ${plan_jobid})"
  _dep_status=0; check_job_for_dependency "${plan_jobid}" || _dep_status=$?
  case $_dep_status in
    0)
      # plan job exists in controller -> safe to pass as dependency
      raw_sample_id=$(sbatch_with_retry --parsable --job-name="${JOB_SAMPLE}" --account="${ACCOUNT}" --partition="${WORKER_PARTITION}" ${WORKER_MEM:+--mem="${WORKER_MEM}"} --dependency="afterok:${plan_jobid}" --array="0-$((e - s))" --export=ALL,HPLT_LANG="${HPLT_LANG}",SHARD_LIST="${SHARD_LIST}",PLAN_FILE="${PLAN_FILE}",SAMPLES_DIR="${SAMPLES_DIR}",SEED_BASE="${SEED_BASE}",OFFSET=${s},MODE=sample "${WORKER}")
      ;;
    1)
      # plan finished successfully and was purged from controller -> submit without dependency
      echo "[ORCH] Plan ${plan_jobid} already finished (accounting OK); submitting sample array without dependency"
      raw_sample_id=$(sbatch_with_retry --parsable --job-name="${JOB_SAMPLE}" --account="${ACCOUNT}" --partition="${WORKER_PARTITION}" ${WORKER_MEM:+--mem="${WORKER_MEM}"} --array="0-$((e - s))" --export=ALL,HPLT_LANG="${HPLT_LANG}",SHARD_LIST="${SHARD_LIST}",PLAN_FILE="${PLAN_FILE}",SAMPLES_DIR="${SAMPLES_DIR}",SEED_BASE="${SEED_BASE}",OFFSET=${s},MODE=sample "${WORKER}")
      ;;
    *)
      echo "[ORCH] Plan job ${plan_jobid} not found or failed; aborting" >&2
      sacct -j "${plan_jobid}" --format=JobID,State,ExitCode,Submit,Start,End || true
      exit 1
      ;;
  esac

  sample_jid=$(sanitize_jobid "${raw_sample_id}")
  if [ -z "${sample_jid}" ]; then
    echo "[ORCH] Failed to obtain valid sample job id from sbatch output: '${raw_sample_id}'" >&2
    echo "[ORCH DEBUG] raw sbatch output: ${raw_sample_id}" >&2
    exit 1
  fi
  last_sample_jobid="${sample_jid}"
  echo "[ORCH] Submitted sample job ${last_sample_jobid}"
done

# submit concatenation job dependent on last sample batch
echo "[ORCH] Submitting concat job dependent on ${last_sample_jobid}"
_dep_status=0; check_job_for_dependency "${last_sample_jobid}" || _dep_status=$?
case $_dep_status in
  0)
    raw_concat_id=$(sbatch_with_retry --parsable --job-name="${JOB_CONCAT}" --account="${ACCOUNT}" --partition="${WORKER_PARTITION}" ${WORKER_MEM:+--mem="${WORKER_MEM}"} --dependency="afterok:${last_sample_jobid}" --export=ALL,HPLT_LANG="${HPLT_LANG}",SAMPLES_DIR="${SAMPLES_DIR}",PLAN_FILE="${PLAN_FILE}",FINAL_FILE="${FINAL_FILE}",SEED_BASE="${SEED_BASE}",SHUFFLE="${SHUFFLE}",MODE=concat "${WORKER}")
    ;;
  1)
    echo "[ORCH] Sample batch ${last_sample_jobid} already finished (accounting OK); submitting concat without dependency"
    raw_concat_id=$(sbatch_with_retry --parsable --job-name="${JOB_CONCAT}" --account="${ACCOUNT}" --partition="${WORKER_PARTITION}" ${WORKER_MEM:+--mem="${WORKER_MEM}"} --export=ALL,HPLT_LANG="${HPLT_LANG}",SAMPLES_DIR="${SAMPLES_DIR}",PLAN_FILE="${PLAN_FILE}",FINAL_FILE="${FINAL_FILE}",SEED_BASE="${SEED_BASE}",SHUFFLE="${SHUFFLE}",MODE=concat "${WORKER}")
    ;;
  *)
    echo "[ORCH] Sample job ${last_sample_jobid} not found or failed; aborting" >&2
    sacct -j "${last_sample_jobid}" --format=JobID,State,ExitCode,Submit,Start,End || true
    exit 1
    ;;
esac

concat_jid=$(sanitize_jobid "${raw_concat_id}")
if [[ -z "${concat_jid}" ]]; then
  echo "[ORCH] Failed to obtain valid concat job id from sbatch output: '${raw_concat_id}'" >&2
  exit 1
fi
echo "[ORCH] Submitted concat job ${concat_jid}"
echo "[ORCH] Orchestrator finished submitting pipeline. Monitor with squeue."
