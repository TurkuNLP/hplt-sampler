#!/bin/bash
# Worker for hplt-sample: submitted by the submitter with --account, --partition, --mem,
# --time and the environment below; not meant to be run by hand.
#
#   MODE=count|sample   one array task = one packed list of shards: ${RUNDIR}/tasks/${MODE}-NNN.txt
#   MODE=plan           merge the run's fresh counts into the index, write plan.jsonl
#   MODE=finalize       check every shard's read count against the plan (and index),
#                       then concatenate and shuffle
#
#SBATCH --job-name=hplt_sampler
#SBATCH --nodes=1
#SBATCH --ntasks=1

set -euo pipefail

RUNDIR="${RUNDIR:?RUNDIR required}"
MODE="${MODE:?MODE required}"
HERE="${SAMPLER_HOME:?SAMPLER_HOME required}"
PYTHON="${PYTHON:-python3}"
if [[ -n "${MODULE_LOAD_CMD:-}" ]]; then
  eval "${MODULE_LOAD_CMD}"
fi
SAMPLES_DIR="${RUNDIR}/samples"
FINAL_FILE="${RUNDIR}/samples.jsonl"
HPLT_LANG="$("${PYTHON}" -c 'import json,sys; print(json.load(open(sys.argv[1]))["lang"])' "${RUNDIR}/run.json")"

case "${MODE}" in
  count|sample)
    TASK_FILE=$(printf '%s/tasks/%s-%03d.txt' "${RUNDIR}" "${MODE}" "${SLURM_ARRAY_TASK_ID:?array task id}")
    echo "[WORKER] MODE=${MODE} task ${SLURM_ARRAY_TASK_ID}: $(wc -l < "${TASK_FILE}") shards"
    failed=0
    while IFS= read -r SHARD; do
      [[ -z "${SHARD}" ]] && continue
      if [[ "${MODE}" == count ]]; then
        "${PYTHON}" -u "${HERE}/counts.py" "${HPLT_LANG}" "${SHARD}" --counts-dir "${RUNDIR}/counts" || failed=$((failed + 1))
      else
        "${PYTHON}" -u "${HERE}/sample.py" "${HPLT_LANG}" "${SHARD}" --plan "${RUNDIR}/plan.jsonl" \
          --outdir "${SAMPLES_DIR}" --seed-base "${SEED_BASE:?SEED_BASE required}" || failed=$((failed + 1))
      fi
    done < "${TASK_FILE}"
    if (( failed > 0 )); then
      echo "[WORKER] ${failed} shard(s) failed in this task; the others are done. Resume with: hplt-sample --resume ${RUNDIR}" >&2
      exit 1
    fi
    ;;
  plan)
    "${PYTHON}" -u "${HERE}/plan.py" "${RUNDIR}"
    ;;
  finalize)
    "${PYTHON}" -u "${HERE}/finalize.py" "${RUNDIR}"
    # concatenation order is the shell's glob order, as in every earlier run, so seeded runs reproduce
    cat "${SAMPLES_DIR}"/*.jsonl > "${FINAL_FILE}"
    if [[ -s "${FINAL_FILE}" && "${SHUFFLE:-true}" == "true" ]]; then
      # per-shard samples are grouped by shard (WDS score, source); shuffle so any prefix is a random sample
      "${PYTHON}" -u "${HERE}/shuffle.py" "${FINAL_FILE}" --seed-base "${SEED_BASE:?SEED_BASE required}"
    fi
    if [[ -s "${FINAL_FILE}" ]]; then
      rm -rf "${SAMPLES_DIR}"
      echo "[WORKER] Concatenated to ${FINAL_FILE} and removed per-shard samples"
    else
      echo "[WORKER] ERROR: ${FINAL_FILE} is empty; keeping ${SAMPLES_DIR} for inspection" >&2
      exit 1
    fi
    ;;
  *)
    echo "Unknown MODE=${MODE}" >&2
    exit 2
    ;;
esac
