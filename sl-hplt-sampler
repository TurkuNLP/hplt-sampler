#!/bin/bash

# NOTE: Edit --account and --partition below for your system,
# OR let the orchestrator override them when submitting this worker.
# See hplt-sampler.conf.example for configuration.

#SBATCH --job-name=hplt_sampler
#SBATCH --account=YOUR_ACCOUNT_HERE
#SBATCH --partition=YOUR_PARTITION_HERE
#SBATCH --mem=32G
#SBATCH --time=03:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --output=slurm-logs/array_%A_%a.out
#SBATCH --error=slurm-logs/array_%A_%a.err
#SBATCH --array=0-0

# This worker script is intended to be launched by the orchestrator (sl-orchestrator).
# It performs one of: counts, sample, plan, concat depending on the MODE env var.

set -euo pipefail

# Make logging a bit easier
mkdir -p slurm-logs
# Use safe defaults for SLURM array variables so non-array jobs (plan/concat) do not fail
ARR_TASK="${SLURM_ARRAY_TASK_ID:-none}"
ARR_JOB="${SLURM_ARRAY_JOB_ID:-${SLURM_JOB_ID:-nojob}}"
rm -f "slurm-logs/current_${SLURM_JOB_NAME}_${ARR_TASK}.err" || true
rm -f "slurm-logs/current_${SLURM_JOB_NAME}_${ARR_TASK}.out" || true
ln -s "array_${ARR_JOB}_${ARR_TASK}.err" "slurm-logs/current_${SLURM_JOB_NAME}_${ARR_TASK}.err" || true
ln -s "array_${ARR_JOB}_${ARR_TASK}.out" "slurm-logs/current_${SLURM_JOB_NAME}_${ARR_TASK}.out" || true

HPLT_LANG="${HPLT_LANG:-eng_Latn}"
RUNDIR="${RUNDIR:-${PWD}/results-${HPLT_LANG}-all}"
SHARD_LIST="${SHARD_LIST:-${RUNDIR}/shard_list.txt}"
MODE="${MODE:-counts}"
PLAN_FILE="${PLAN_FILE:-${RUNDIR}/plan.jsonl}"
COUNTS_DIR="${COUNTS_DIR:-${PWD}/counts/${HPLT_LANG}}"
SAMPLES_DIR="${SAMPLES_DIR:-${RUNDIR}/samples}"
FINAL_FILE="${FINAL_FILE:-${RUNDIR}/samples.jsonl}"

# load optional Python environment (set MODULE_LOAD_CMD in hplt-sampler.conf)
CONFIG="${PWD}/hplt-sampler.conf"
# shellcheck source=/dev/null
[[ -f "${CONFIG}" ]] && source "${CONFIG}"
if [[ -n "${MODULE_LOAD_CMD:-}" ]]; then
  eval "${MODULE_LOAD_CMD}"
fi
# Interpreter for the Python stages (set PYTHON in hplt-sampler.conf). On LUMI, local v4
# shards need one that can see /appl/local/openeurollm, e.g. the system /usr/bin/python3.
PYTHON="${PYTHON:-python3}"

if [ "$MODE" != "plan" ] && [ "$MODE" != "concat" ]; then
  if [ -z "${SHARD_LIST:-}" ] || [ ! -r "${SHARD_LIST:-}" ]; then
    echo "SHARD_LIST not provided or unreadable" >&2
    exit 1
  fi

  OFFSET="${OFFSET:-0}"
  idx=$((OFFSET + SLURM_ARRAY_TASK_ID + 1))
  SHARD_URL=$(sed -n "${idx}p" "$SHARD_LIST")
  if [ -z "${SHARD_URL:-}" ]; then
    echo "No shard URL at line ${idx} in ${SHARD_LIST}" >&2
    exit 1
  fi
fi

case "$MODE" in
  counts)
    echo "[WORKER] MODE=counts LANG=${HPLT_LANG} SHARD=${SHARD_URL}"
    "${PYTHON}" -u counts.py "$HPLT_LANG" "$SHARD_URL" --counts-dir "$COUNTS_DIR"
    ;;
  sample)
    echo "[WORKER] MODE=sample LANG=${HPLT_LANG} SHARD=${SHARD_URL} PLAN=${PLAN_FILE}"
    "${PYTHON}" -u sample.py "$HPLT_LANG" "$SHARD_URL" --plan "$PLAN_FILE" --outdir "$SAMPLES_DIR"
    ;;
  plan)
    echo "[WORKER] MODE=plan LANG=${HPLT_LANG} SHARD_LIST=${SHARD_LIST} COUNTS_DIR=${COUNTS_DIR} OUT=${PLAN_FILE}"
    "${PYTHON}" -u plan.py "${HPLT_LANG}" --shard-list "${SHARD_LIST}" --counts-dir "${COUNTS_DIR}" --out "${PLAN_FILE}" ${N_SAMPLES:+--n-samples "${N_SAMPLES}"}
    ;;
  concat)
    echo "[WORKER] MODE=concat SAMPLES_DIR=${SAMPLES_DIR}"
    mkdir -p "${SAMPLES_DIR}"
    cat "${SAMPLES_DIR}"/*.jsonl > "${FINAL_FILE}"
    if [[ -s "${FINAL_FILE}" ]]; then
      rm -rf "${SAMPLES_DIR}"
      echo "[WORKER] Concatenated to ${FINAL_FILE} and removed per-shard samples"
    else
      echo "[WORKER] ERROR: ${FINAL_FILE} is empty; keeping ${SAMPLES_DIR} for inspection" >&2
      exit 1
    fi
    ;;
  *)
    echo "Unknown MODE=${MODE}" >&2
    exit 2
    ;;
esac
