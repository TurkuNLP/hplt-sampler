# Copy this file to hplt-sampler.conf and fill in the values.
# hplt-sampler.conf is gitignored and never committed.

# REQUIRED: Your Slurm project account (e.g. project_462000999).
ACCOUNT=""

# NOTE: The orchestrator's own partition cannot be set here — #SBATCH directives
# are parsed by Slurm before this file is read. Edit #SBATCH --partition in
# sl-orchestrator directly, or pass --partition=X on the sbatch command line.

# REQUIRED: Slurm partition for worker array jobs (counts, plan, sample, concat).
WORKER_PARTITION="small"

# OPTIONAL: Shell command(s) to activate the Python environment in worker jobs.
# Leave empty if `requests` and `zstandard` are already available (pip install --user).
# Verify a lighter module works on your system before using a heavy one.
# Example for LUMI (pytorch always works; find a lighter alternative if possible):
#   MODULE_LOAD_CMD="module use /appl/local/csc/modulefiles && module load pytorch"
MODULE_LOAD_CMD=""

# OPTIONAL: Python interpreter for worker jobs (default: python3 on PATH).
# Local-shard mode (--corpus v4) needs only the standard library plus the `zstdcat` binary.
# PYTHON="/usr/bin/python3"

# OPTIONAL: Memory per worker task (default: the worker's #SBATCH --mem=32G).
# WORKER_MEM="4G"


# OPTIONAL: Shared counts index (exact documents per shard). Runs whose shards are all
# in it skip counting. Default: counts-index/ next to this script.
# COUNTS_INDEX="/projappl/project_XXXXXXXXX/hplt-counts"

# OPTIONAL: Array tasks a run may queue at once (default: per partition; LUMI small 200).
# MAX_TASKS=200
